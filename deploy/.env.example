# UpLoop environment example.
# Copy this file to `.env` in the project root (same directory as package.json)
# and replace every placeholder before using `npm start` or `npm run migrate`.
# Never commit a real `.env`. Values should not be quoted if a process manager
# reads KEY=value files directly.

# HTTP
PORT=3200
HOST=127.0.0.1
NODE_ENV=development

# URL prefix for routes, the injected <base href>, and the session cookie Path.
# The local demo script (`npm run demo`) defaults to /task and port 8896.
# Leave BASE_PATH empty only when you intentionally host at the domain root.
BASE_PATH=/task
# Must stay 1 if the Node server should serve the web/ frontend itself.
SERVE_STATIC=1

# Feature flags (0 = suspended; set to 1 to enable)
WELLNESS_ENABLED=0
TASK_REFLECTION_ENABLED=0

# PostgreSQL — placeholders only. Required for `npm start` and `npm run migrate`.
# Not required for `npm run demo` (in-memory data) or the unit test suite.
# Point this at a local database. Do not paste a remote URL or a real password.
DATABASE_URL=postgresql://uploop:replace-with-a-local-password@127.0.0.1:5432/uploop
# 001 is the default cap. 002 requires the PostgreSQL ltree extension; enable
# it only after `SELECT * FROM pg_available_extensions WHERE name='ltree';`
MIGRATE_MAX=001

# Session and device tokens. These are explicit placeholders, not usable secrets.
# Generate your own, for example: openssl rand -hex 32
# JWT_SECRET must be at least 16 characters for `npm start`.
JWT_SECRET=replace-with-a-long-random-string
DEVICE_TOKEN_SECRET=replace-with-a-long-random-string

# Optional model providers. Leave keys empty to disable paid model calls.
# Official API hostnames below are public documentation defaults from the code,
# not credentials.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DASHSCOPE_API_KEY=
ASR_MODEL=fun-asr
ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ASR_YUAN_PER_SECOND=0.00022
TTS_MODEL=qwen3-tts-flash
TTS_VOICE=Cherry
TTS_YUAN_PER_CHAR=0.0002

# Quotas (defaults match server/src/env.ts)
LIMIT_YUAN=50
WARN_YUAN=40
LI_PER_YUAN=1000
CATALOG_VERSION=1
CHAT_RATE_PER_MINUTE=20

# Optional extra data directory; defaults to ./data next to package.json
DATA_DIR=
