{
  "name": "uploop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "UpLoop: Express + TypeScript + PostgreSQL web app",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx server/src/index.ts",
    "dev": "tsx watch server/src/index.ts",
    "demo": "tsx server/scripts/demo.ts",
    "migrate": "tsx server/src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test server/test/*.test.ts",
    "nightly": "tsx server/scripts/nightly.ts",
    "migrate:mysql": "tsx server/scripts/migrate-mysql-to-pg.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5",
    "pg": "8.13.1",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.9.3"
  }
}
